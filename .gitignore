# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Environment / secrets
.env
.env.*
!.env.example

# Local data (SQLite DB, exports, personas overrides) — repo-root runtime dir
# ONLY. The leading / matters: an unanchored "data/" would also ignore packaged
# game-adapter data like game_companion/games/zzz/data/.
/data/
*.db
*.sqlite3

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
*.swp

# Local service runtime artifacts (start-service.sh)
serve.log
serve.pid
