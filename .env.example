# Gacha Companion configuration
# Copy to .env (never commit .env) or export these in your shell.
# All values optional; sensible defaults are documented in docs/architecture.md.

# --- LLM endpoint (OpenAI-compatible) ---
# Remote inference endpoint, e.g. an Open WebUI-compatible router.
GAME_COMPANION_LLM_BASE_URL=https://llm.tictac.one/v1
# NEVER commit a real key. Keep it in .env or your shell environment only.
GAME_COMPANION_LLM_API_KEY=
# Multimodal model used for conversation + screenshot extraction.
GAME_COMPANION_LLM_MODEL=muse-glimmer-30b-vlm-128k
GAME_COMPANION_LLM_TIMEOUT_SECONDS=120

# --- Local data ---
# Directory for the SQLite database, exports, personas and data overrides.
# Default: ~/.local/share/gacha-companion
GAME_COMPANION_DATA_DIR=

# Override the derived SQLite URL entirely if needed.
# Default: sqlite:///<data_dir>/gacha_companion.db
GAME_COMPANION_DATABASE_URL=

# --- Local service binding (localhost only by default; do NOT expose to LAN) ---
GAME_COMPANION_HOST=127.0.0.1
GAME_COMPANION_PORT=8765

# --- Logging ---
GAME_COMPANION_LOG_LEVEL=INFO
GAME_COMPANION_LOG_JSON=false

# --- Research / web search (optional) ---
# SearXNG instance base URL, e.g. http://127.0.0.1:8888
GAME_COMPANION_SEARXNG_BASE_URL=
